# ─────────────────────────────────────────────────────────────────────────────
# Ganja Livre – Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Use a strong random password. In production, prefer a MongoDB Atlas URI with TLS.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=92fd3d4a32d16c3c0dda28dacb70355bf2d66d18ce496e824156ba9585d8f1e9
MONGODB_DATABASE=ganja_livre
MONGODB_MAX_POOL_SIZE=100
MONGODB_CONNECT_TIMEOUT=10s

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=2299cae49de38cf97213225c7a74045c99222920d83e6aa2120c3e5a9526920a98b93e253d175b3cff510c59465c2ad18d3967b68fe8cc63e95e8ad2d8cea8be
JWT_REFRESH_SECRET=8cd1cab31ad7a24b212cf8a7a7151fab720b39638ffdcc1d6aeacd99c22bf949407f0de091712be94123bfffd04d0cc713a6ad867b8c48edb293b49093c6a99e
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h   # 7 days

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ganja-livre-sales

# ── Temporal PostgreSQL (internal Temporal dependency) ────────────────────────
TEMPORAL_DB_PASSWORD=8ef39de88f9cf9a57bdd27e8717754e4be93b95aa8cb32d1fbc7f8b20565b6d2
